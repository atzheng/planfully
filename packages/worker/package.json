{
  "name": "@planfully/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "predev": "test -f .dev.vars || cp .dev.vars.example .dev.vars; mkdir -p ../web/dist",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval-llm.ts",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@planfully/shared": "workspace:*",
    "hono": "^4.13.19",
    "postal-mime": "^2.7.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  }
}
