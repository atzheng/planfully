{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planfully",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [{ "pattern": "planfully.us", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planfully",
      "database_id": "cf9247c4-02cb-4c00-bc17-bb1978cc4275",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "planfully-blobs" }],
  "vars": {
    "TRIP_DOMAIN": "planfully.us",
  },
}
